# ─────────────────────────────────────────────
# Link2NAS — Docker sample environment file
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────


# ── App bootstrap ─────────────────────────────
APP_NAME=link2nas
APP_TAGLINE=Job management + debrid provider
APP_VERSION=0.1.0

# URL publique de base, sans slash final.
# Exemple local : http://127.0.0.1:5000
# Exemple prod : https://link2nas.example.com
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Clé de session Flask — obligatoire en production.
FLASK_SECRET_KEY=CHANGE_ME_long_random_string


# ── Sécurité / chiffrement ────────────────────
# Générer avec :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
V2_SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key


# ── Mode applicatif ───────────────────────────
DEBUG=false
V2_DEV_ROUTES_ENABLED=false

# Optionnel : mode sans login multi-user.
LINK2NAS_SINGLE_USER_MODE=false
LINK2NAS_SINGLE_USER_EMAIL=user@example.com
LINK2NAS_SINGLE_USER_DISPLAY_NAME=Admin


# ── Chemins internes conteneur ─────────────────
DATA_DIR=/app/data
USERDATA_DIR=/app/data/userdata
TORRENT_DIR=/app/data/torrents
TEMP_DIR=/app/tmp/link2nas
LOG_DIR=/app/logs


# ── Base de données ───────────────────────────
# Valeurs possibles : sqlite ou postgres
V2_DATABASE_BACKEND=sqlite

# SQLite — recommandé pour démarrage simple
V2_SQLITE_PATH=/app/data/link2nas_v2.sqlite3

# PostgreSQL — utilisé seulement si V2_DATABASE_BACKEND=postgres
# En Docker Compose, le host est le nom du service : postgres
V2_POSTGRES_DSN=postgresql://link2nas:change_me@postgres:5432/link2nas_v2

# Variables du conteneur PostgreSQL si le service postgres est activé
POSTGRES_DB=link2nas_v2
POSTGRES_USER=link2nas
POSTGRES_PASSWORD=change_me


# ── Redis ─────────────────────────────────────
# En Docker Compose, le host est le nom du service : redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Optionnel : DSN complet, principalement utilisé par le rate limiter.
# Si défini, il peut être prioritaire selon le code.
REDIS_URL=redis://redis:6379/0

RQ_QUEUE_NAME=link2nas
RQ_LOCAL_DOWNLOAD_QUEUE_NAME=link2nas-local-downloads


# ── Rate limiting ─────────────────────────────
V2_RATE_LIMIT_ENABLED=true

# En prod Docker, je mettrais true.
# En dev, false évite de bloquer si Redis est absent/mal lancé.
V2_RATE_LIMIT_REDIS_REQUIRED=false


# ── Providers debrid ──────────────────────────
REALDEBRID_BASE_URL=https://api.real-debrid.com/rest/1.0
REALDEBRID_TIMEOUT=30.0

ALLDEBRID_BASE_URL=https://api.alldebrid.com
ALLDEBRID_TIMEOUT=30.0


# ── Flask / Gunicorn ──────────────────────────
HOST=0.0.0.0
PORT=5000