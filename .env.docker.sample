# ─────────────────────────────────────────────
# Link2NAS — Docker environment sample file (SQLite)
# Copy to .env and fill in your values.
# Redis and database hostnames are pre-set to Docker Compose service names.
# For PostgreSQL, use .env.docker.postgres.sample instead.
# ─────────────────────────────────────────────


# ── App ───────────────────────────────────────
# Initial values — overridable at runtime in Admin > General.
APP_NAME=link2nas
APP_TAGLINE=Job management + debrid provider
APP_VERSION=3.0.0-beta4

# Base URL used in outbound links: invitations, password reset, magic login,
# email verification, and public file links. No trailing slash.
# Example (local):      http://localhost:5000
# Example (production): https://link2nas.example.com
PUBLIC_BASE_URL=http://localhost:5000


# ── Secrets ───────────────────────────────────
# Required. Must be a strong random string, minimum 20 characters, not a placeholder.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CHANGE_ME_long_random_string

# Required. Must be a valid Fernet key.
# WARNING: Do not lose this key. Provider, SMTP, and destination credentials stored in the
# database are encrypted with it. Changing it without a migration makes them permanently unreadable.
# Back up this key together with the link2nas_data volume.
# Generate both secrets at once:
#   python3 - <<'PY'
#   import secrets
#   from cryptography.fernet import Fernet
#   print("FLASK_SECRET_KEY=" + secrets.token_urlsafe(48))
#   print("V2_SECRET_ENCRYPTION_KEY=" + Fernet.generate_key().decode())
#   PY
V2_SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key


# ── Single-user mode ──────────────────────────
# Optional. When true, the application skips registration and maintains a single fixed account.
LINK2NAS_SINGLE_USER_MODE=false
LINK2NAS_SINGLE_USER_EMAIL=user@example.com
LINK2NAS_SINGLE_USER_DISPLAY_NAME=Admin


# ── Container storage paths ───────────────────
# These paths match the Docker Compose volume mounts defined in docker-compose.yml.
# Do not change unless you also update the volume mount paths in the compose file.
DATA_DIR=/app/data
USERDATA_DIR=/app/data/userdata
TORRENT_DIR=/app/data/torrents
TEMP_DIR=/app/tmp/link2nas
LOG_DIR=/app/logs


# ── Database ──────────────────────────────────
# "sqlite" (default) or "postgres"
V2_DATABASE_BACKEND=sqlite

# SQLite — stored inside the link2nas_data volume.
V2_SQLITE_PATH=/app/data/link2nas_v2.sqlite3

# PostgreSQL — only used when V2_DATABASE_BACKEND=postgres.
# The hostname must be the Docker Compose service name (postgres).
# The password here must match POSTGRES_PASSWORD below.
# V2_POSTGRES_DSN=postgresql://link2nas:CHANGE_ME_postgres_password@postgres:5432/link2nas_v2

# PostgreSQL container variables — used by the postgres service image, not by the application.
# POSTGRES_PASSWORD must match the password in V2_POSTGRES_DSN.
# WARNING: changing POSTGRES_PASSWORD after the postgres volume is initialized does not
# automatically update the database password. You must also change it inside the container.
# POSTGRES_DB=link2nas_v2
# POSTGRES_USER=link2nas
# POSTGRES_PASSWORD=CHANGE_ME_postgres_password


# ── Redis ─────────────────────────────────────
# Docker Compose service hostname — matches the service name in docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Full Redis DSN — used by the rate limiter when set. Takes precedence over HOST/PORT/DB.
REDIS_URL=redis://redis:6379/0

RQ_QUEUE_NAME=link2nas
RQ_LOCAL_DOWNLOAD_QUEUE_NAME=link2nas-local-downloads


# ── Rate limiting ─────────────────────────────
V2_RATE_LIMIT_ENABLED=true
# Recommended: true in production multi-container deployments.
# When true, the application refuses to start if Redis is unavailable, which prevents
# containers from running without shared rate limit state.
# When false, falls back to per-process in-memory state (not shared across containers).
V2_RATE_LIMIT_REDIS_REQUIRED=false


# ── Debrid providers ──────────────────────────
# Provider credentials are configured per user in the Settings UI, not here.
# These variables control API endpoint URLs and timeouts. Defaults are suitable for most deployments.
REALDEBRID_BASE_URL=https://api.real-debrid.com/rest/1.0
REALDEBRID_TIMEOUT=30.0

ALLDEBRID_BASE_URL=https://api.alldebrid.com
ALLDEBRID_TIMEOUT=30.0


# ── Logging ───────────────────────────────────
# Optional — defaults to INFO.
# LOG_LEVEL=INFO


# ── Flask / Gunicorn ──────────────────────────
# Never enable DEBUG in production. V2_DEV_ROUTES_ENABLED only has effect when DEBUG=true.
DEBUG=false
V2_DEV_ROUTES_ENABLED=false

# Bind address and port — used by python app.py only.
# In Docker, gunicorn is launched directly by docker-compose.yml with a fixed bind address.
# HOST=0.0.0.0
# PORT=5000
