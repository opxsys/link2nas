# ─────────────────────────────────────────────
# Link2NAS — sample environment file
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────


# ── App bootstrap ─────────────────────────────
# Fallback initial pour le nom/tagline — configurable ensuite dans Admin UI.
APP_NAME=link2nas
APP_TAGLINE=Job management + debrid provider
APP_VERSION=0.1.0

# URL publique de base, sans slash final.
# Sert de valeur initiale/fallback. Peut ensuite être modifiée dans Admin > Général.
# Utilisée pour générer les liens publics, invitations, reset password, email verification et magic-login.
PUBLIC_BASE_URL=https://link2nas.example.com

# Clé de session Flask — doit être longue et aléatoire en production.
FLASK_SECRET_KEY=CHANGE_ME_long_random_string


# ── Sécurité / chiffrement ────────────────────
# Requis en production (quand DEBUG=false).
# Générer avec : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
V2_SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key


# ── Single-user mode (optionnel) ─────────────
LINK2NAS_SINGLE_USER_MODE=false
LINK2NAS_SINGLE_USER_EMAIL=user@example.com
LINK2NAS_SINGLE_USER_DISPLAY_NAME=Admin


# ── Chemins de données ────────────────────────
DATA_DIR=./data
USERDATA_DIR=./data/userdata
TORRENT_DIR=./data/torrents
TEMP_DIR=./tmp/link2nas
LOG_DIR=./logs


# ── Base de données ───────────────────────────
# "sqlite" (défaut) ou "postgres"
V2_DATABASE_BACKEND=sqlite

# SQLite
V2_SQLITE_PATH=./data/link2nas_v2.sqlite3

# PostgreSQL (seulement si V2_DATABASE_BACKEND=postgres)
V2_POSTGRES_DSN=postgresql://link2nas:change_me@127.0.0.1:5432/link2nas_v2


# ── Redis ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL= (DSN complet — prioritaire sur HOST/PORT/DB pour le rate limiter)

RQ_QUEUE_NAME=link2nas
RQ_LOCAL_DOWNLOAD_QUEUE_NAME=link2nas-local-downloads


# ── Rate limiting ─────────────────────────────
V2_RATE_LIMIT_ENABLED=true
# Refuser le démarrage si Redis est indisponible :
V2_RATE_LIMIT_REDIS_REQUIRED=false


# ── Providers debrid ──────────────────────────
REALDEBRID_BASE_URL=https://api.real-debrid.com/rest/1.0
REALDEBRID_TIMEOUT=30.0

ALLDEBRID_BASE_URL=https://api.alldebrid.com
ALLDEBRID_TIMEOUT=30.0


# ── Développement / debug ─────────────────────
DEBUG=false
V2_DEV_ROUTES_ENABLED=false
# HOST=0.0.0.0
# PORT=5000
