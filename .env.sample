# ─────────────────────────────────────────────
# Link2NAS — environment sample file (local installation)
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────


# ── App ───────────────────────────────────────
# Initial values — overridable at runtime in Admin > General.
APP_NAME=link2nas
APP_TAGLINE=Job management + debrid provider
# Optional. Version string shown in Admin > Maintenance. Defaults to "unknown" if not set.
# APP_VERSION=

# Base URL used in outbound links: invitations, password reset, magic login,
# email verification, and public file links. No trailing slash.
# Example (local):      http://localhost:5000
# Example (production): https://link2nas.example.com
PUBLIC_BASE_URL=https://link2nas.example.com


# ── Secrets ───────────────────────────────────
# Required in production (rejected at startup when DEBUG=false if missing or a placeholder).
# Must be a strong random string, minimum 20 characters.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CHANGE_ME_long_random_string

# Required in production. Must be a valid Fernet key.
# WARNING: Do not lose this key. Provider, SMTP, and destination credentials stored in the
# database are encrypted with it. Changing it without a migration makes them permanently unreadable.
# Back up this key together with your database.
# Generate both secrets at once:
#   python3 - <<'PY'
#   import secrets
#   from cryptography.fernet import Fernet
#   print("FLASK_SECRET_KEY=" + secrets.token_urlsafe(48))
#   print("V2_SECRET_ENCRYPTION_KEY=" + Fernet.generate_key().decode())
#   PY
V2_SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key


# ── Single-user mode ──────────────────────────
# Optional. When true, the application skips registration and maintains a single fixed account.
LINK2NAS_SINGLE_USER_MODE=false
LINK2NAS_SINGLE_USER_EMAIL=user@example.com
LINK2NAS_SINGLE_USER_DISPLAY_NAME=Admin


# ── OIDC / SSO authentication ─────────────────
# Generic OpenID Connect (OIDC) support. Disabled by default.
# In single-user mode, OIDC is always disabled regardless of this setting.
# Configuration is via .env only — no Admin UI in v3.6.
# The local email + password login remains available when OIDC is enabled.
OIDC_ENABLED=false

# OIDC provider discovery URL (must expose /.well-known/openid-configuration).
# OIDC_ISSUER=https://idp.example.com

# Application credentials registered with your OIDC provider.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Scopes to request. Must include openid and email.
# OIDC_SCOPES=openid email profile

# Label shown on the SSO button in the login UI.
# OIDC_BUTTON_LABEL=Sign in with SSO

# If true, a new account is created on first OIDC login when no matching account exists.
# Auto-created accounts are always assigned the 'user' role. No super_admin is ever created via OIDC.
# OIDC_AUTO_CREATE_USERS=false

# Restrict auto-creation to specific email domains (comma-separated).
# Only applies when OIDC_AUTO_CREATE_USERS=true. Leave empty to allow all domains.
# OIDC_ALLOWED_DOMAINS=

# Role assigned to auto-created OIDC users. Only 'user' is accepted in this release.
# OIDC_DEFAULT_ROLE=user

# State TTL and exchange-code TTL (seconds).
# OIDC_STATE_TTL_SECONDS=600
# OIDC_EXCHANGE_CODE_TTL_SECONDS=60

# Rate limits for OIDC endpoints (requests / window).
# V2_RATE_LIMIT_OIDC_INITIATE_MAX=20
# V2_RATE_LIMIT_OIDC_INITIATE_WINDOW_SECONDS=300
# V2_RATE_LIMIT_OIDC_CALLBACK_MAX=30
# V2_RATE_LIMIT_OIDC_CALLBACK_WINDOW_SECONDS=300
# V2_RATE_LIMIT_OIDC_COMPLETE_MAX=20
# V2_RATE_LIMIT_OIDC_COMPLETE_WINDOW_SECONDS=300


# ── Storage paths ─────────────────────────────
# Use absolute paths in production. Directories are created automatically on startup.
DATA_DIR=./data
USERDATA_DIR=./data/userdata
TORRENT_DIR=./data/torrents
TEMP_DIR=./tmp/link2nas
LOG_DIR=./logs


# ── Database ──────────────────────────────────
# "sqlite" (default) or "postgres"
V2_DATABASE_BACKEND=sqlite

# SQLite — path to the database file.
V2_SQLITE_PATH=./data/link2nas_v2.sqlite3

# PostgreSQL — required when V2_DATABASE_BACKEND=postgres.
V2_POSTGRES_DSN=postgresql://link2nas:change_me@127.0.0.1:5432/link2nas_v2


# ── Redis ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Full Redis DSN — used by the rate limiter when set. Takes precedence over HOST/PORT/DB.
# REDIS_URL=redis://127.0.0.1:6379/0

RQ_QUEUE_NAME=link2nas
RQ_LOCAL_DOWNLOAD_QUEUE_NAME=link2nas-local-downloads


# ── Rate limiting ─────────────────────────────
V2_RATE_LIMIT_ENABLED=true
# When true, the application refuses to start if Redis is unavailable.
# Recommended in production multi-process deployments to ensure shared rate limit state.
# When false, falls back to per-process in-memory state (not shared across workers).
V2_RATE_LIMIT_REDIS_REQUIRED=false


# ── Debrid providers ──────────────────────────
# Provider credentials are configured per user in the Settings UI, not here.
# These variables control API endpoint URLs and timeouts. Defaults are suitable for most deployments.
REALDEBRID_BASE_URL=https://api.real-debrid.com/rest/1.0
REALDEBRID_TIMEOUT=30.0

ALLDEBRID_BASE_URL=https://api.alldebrid.com
ALLDEBRID_TIMEOUT=30.0


# ── Logging ───────────────────────────────────
# Log level for application output. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Optional — defaults to INFO.
# LOG_LEVEL=INFO


# ── Debug / development ───────────────────────
# Never enable DEBUG in production. V2_DEV_ROUTES_ENABLED only has effect when DEBUG=true.
DEBUG=false
V2_DEV_ROUTES_ENABLED=false

# Bind address and port for python app.py (local dev only — not used by gunicorn in Docker).
# HOST=0.0.0.0
# PORT=5000

# Number of gunicorn worker processes — only relevant when running gunicorn directly.
# Recommended: 1 for small self-hosted instances. See docs/CONFIGURATION.md.
# WEB_CONCURRENCY=1
